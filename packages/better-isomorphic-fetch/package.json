{
  "name": "better-isomorphic-fetch",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/browser.ts",
      "browser": "./dist/browser.js",
      "default": "./dist/node.js"
    }
  },
  "devDependencies": {
    "@opentelemetry/core": "^2.6.1",
    "@opentelemetry/sdk-trace-base": "^2.6.1",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "@types/bun": "latest"
  },
  "files": [
    "dist",
    "src/*.ts",
    "!src/*.test.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build ./src/browser.ts --outdir ./dist --target browser && bun build ./src/node.ts --outdir ./dist --target node",
    "lint": "tsc --noEmit",
    "publish": "npm publish --access public",
    "test": "bun test"
  },
  "peerDependencies": {
    "typescript": "^5",
    "@opentelemetry/api": "^1.9.1"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "dependencies": {
    "undici": "^7.24.6"
  }
}
